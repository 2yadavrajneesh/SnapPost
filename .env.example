# SnapPost needs no environment variables to run. Everything below is optional.

# Base URL of the FxEmbed API used to fetch posts (default: https://api.fxtwitter.com).
# Point this at your own FxEmbed instance if you self-host it.
# FX_API_BASE=https://api.fxtwitter.com

# Extra hosts the image/video proxies may fetch from, comma-separated (host or host:port).
# Only needed if you self-host a media CDN. By default only X's own image/video hosts are allowed.
# MEDIA_PROXY_HOSTS=cdn.example.com
