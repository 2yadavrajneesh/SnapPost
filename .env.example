# SnapPost needs no environment variables to run. Everything below is optional.

# Base URL of the FxEmbed API used to fetch posts (default: https://api.fxtwitter.com).
# Point this at your own FxEmbed instance if you self-host it.
# FX_API_BASE=https://api.fxtwitter.com

# Extra hosts the image/video proxies may fetch from, comma-separated (host or host:port).
# Only needed if you self-host a media CDN. By default only X's own image/video hosts are allowed.
# MEDIA_PROXY_HOSTS=cdn.example.com

# Per-IP rate limiting. Without the two Upstash values the limits are counted in server memory (weaker).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Defaults: tweet/thread 30 per 10 min, media 300 per 10 min, video downloads 10 per hour (window in seconds).
# RATE_LIMIT_API_MAX=30
# RATE_LIMIT_API_WINDOW_SEC=600
# RATE_LIMIT_MEDIA_MAX=300
# RATE_LIMIT_MEDIA_WINDOW_SEC=600
# RATE_LIMIT_DOWNLOAD_MAX=10
# RATE_LIMIT_DOWNLOAD_WINDOW_SEC=3600
# RATE_LIMIT_ARCHIVE_MAX=8
# RATE_LIMIT_ARCHIVE_WINDOW_SEC=600
